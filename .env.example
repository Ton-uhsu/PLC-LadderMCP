# Remote MCP machine authentication. Configure this token only in the AI/MCP client.
PLC_LADDER_TOKEN=
PLC_LADDER_URL=

# Human Web login (MVP: one admin account from environment variables).
PLC_LADDER_WEB_USERNAME=admin
PLC_LADDER_WEB_PASSWORD=
PLC_LADDER_WEB_SESSION_SECRET=
PLC_LADDER_WEB_SESSION_TTL_SECONDS=28800

# Restrict this to the deployed GitHub Pages origin before public VPS exposure.
CORS_ORIGIN=
