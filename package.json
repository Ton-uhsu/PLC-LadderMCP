{
  "name": "plc-ladder-mcp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11",
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build",
    "mcp:dev": "npm --workspace services/mcp-server run dev",
    "mcp:build": "npm --workspace services/mcp-server run build",
    "server": "npm --workspace services/mcp-server run server",
    "mcp:test": "npm --workspace services/mcp-server run test:smoke",
    "mcp:e2e": "npm --workspace services/mcp-server run test:e2e",
    "db:up": "docker compose -f compose.local.yaml up -d --wait",
    "db:stop": "docker compose -f compose.local.yaml stop",
    "db:migrate": "npm run db:migrate:up",
    "db:test": "npm --workspace services/mcp-server run test:persistence",
    "web:test": "node --import tsx --test apps/web/tests/*.test.ts",
    "db:migrate:up": "node scripts/goose.mjs up",
    "db:migrate:down": "node scripts/goose.mjs down",
    "db:migrate:status": "node scripts/goose.mjs status",
    "db:migrate:adopt": "node scripts/adopt-kysely.mjs",
    "db:migrate:validate": "node scripts/goose.mjs validate"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
